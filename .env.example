# Local : rien requis (SQLite dans ./data).
# Distant : renseigner UNE des deux URL ci-dessous + Blob pour les fichiers.
# Postgres (Neon / Vercel Postgres)
DATABASE_URL=postgresql://user:password@host:5432/suivi
# MySQL (PlanetScale / Railway / Aiven) — prioritaire si MYSQL_URL est défini
MYSQL_URL=mysql://user:password@host:3306/suivi
BLOB_READ_WRITE_TOKEN=vercel_blob_xxx
PUBLIC_ORIGIN=https://suivi.vercel.app
COOKIE_SECURE=1
TRUST_PROXY=1
# PGSSL=disable # décommente en local si Postgres sans SSL
# MYSQL_SSL=disable # décommente si MySQL local sans SSL
