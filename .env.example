# Local par defaut : rien requis (SQLite dans ./data).
# Local PostgreSQL : copier ce fichier en .env puis renseigner DATABASE_URL.

# PostgreSQL local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/suivi
# PGSSL=disable # optionnel : localhost desactive deja SSL automatiquement

# MySQL local ou distant, prioritaire si MYSQL_URL est defini
# MYSQL_URL=mysql://user:password@host:3306/suivi
# MYSQL_SSL=disable # decommenter si MySQL local sans SSL

# Production distante
# BLOB_READ_WRITE_TOKEN=vercel_blob_xxx
# PUBLIC_ORIGIN=https://suivi.vercel.app
# COOKIE_SECURE=1
# TRUST_PROXY=1
